{
  "name": "map-of-content",
  "version": "1.8.0",
  "description": "Map of Content plugin",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js --environment BUILD:production",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepare": "husky install",
    "prettier": "prettier --write --plugin-search-dir=. .",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"rollup.config.js\" \"scripts/**/*.mjs\"",
    "test": "rm -rf tests/dist && tsc -p tests/tsconfig.json && node tests/dist/tests/logic.test.js",
    "validate": "npm run check && npm run lint && npm test && npm run build && node scripts/validate-plugin.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^18.1.0",
    "@rollup/plugin-node-resolve": "^11.2.1",
    "@rollup/plugin-typescript": "^8.2.5",
    "@tsconfig/svelte": "^2.0.1",
    "@types/node": "^14.17.9",
    "husky": "^7.0.0",
    "obsidian": "^1.4.0",
    "prettier": "^2.5.0",
    "prettier-plugin-svelte": "^2.5.0",
    "pretty-quick": "^3.1.2",
    "rollup": "^2.55.1",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-svelte": "^7.1.0",
    "svelte": "^3.42.0",
    "svelte-check": "^2.0.0",
    "svelte-preprocess": "^4.7.4",
    "tslib": "^2.2.0",
    "typescript": "^4.3.5",
    "eslint": "8.57.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "eslint-config-prettier": "8.10.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10"
}
